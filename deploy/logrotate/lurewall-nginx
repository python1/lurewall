# Lurewall lab: size-based rotation for nginx's JSON access log.
#
# Install as /etc/logrotate.d/lurewall-nginx (runbook, Phase 2). With the timer
# override next to this file, logrotate runs every 15 minutes, so a flood
# cannot fill the 8 GB disk between daily runs: the log rotates once it passes
# maxsize, whatever the hour.
#
# No copytruncate: nginx reopens its log after the rename, and Lurewall's
# reader follows the renamed file to its end before moving to the new one.
/var/log/nginx/lurewall.json.log {
    daily
    maxsize 100M
    rotate 10
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        invoke-rc.d nginx rotate >/dev/null 2>&1 || true
    endscript
}
