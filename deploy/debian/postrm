#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu

# Package removal and purge both leave application evidence and its account.
case "${1-}" in
    remove|purge)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] &&
            command -v systemctl >/dev/null 2>&1; then
            systemctl --system daemon-reload >/dev/null ||
                echo "lurewall: could not refresh systemd after removal" >&2
        fi
        ;;
esac

if [ "${1-}" = purge ] && command -v deb-systemd-helper >/dev/null 2>&1; then
    deb-systemd-helper purge lurewall.service lurewall-sweeper.timer lurewall-notify.timer
fi
