#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu

case "${1-}" in
    install|upgrade) ;;
    *) exit 0 ;;
esac

if [ -n "${DPKG_ROOT:-}" ]; then
    echo "lurewall: configure the package inside its target root" >&2
    exit 1
fi

refuse_existing() {
    if [ -e "$1" ] || [ -L "$1" ]; then
        echo "lurewall: unmanaged installation conflicts at $1. Detach nginx and remove the unmanaged installation first; keep the evidence." >&2
        exit 1
    fi
}

refuse_existing /opt/lurewall/.operator-managed
refuse_existing /opt/lurewall/current
refuse_existing /usr/local/sbin/lurewall
refuse_existing /usr/local/bin/lurewall
for unit in lurewall.service lurewall-sweeper.service lurewall-sweeper.timer \
    lurewall-notify.service lurewall-notify.timer lurewall-notify-failure.service lurewall-fetch.service lurewall-fetch.timer; do
    refuse_existing "/etc/systemd/system/$unit"
    refuse_existing "/run/systemd/system/$unit"
    if [ "$1" = install ]; then
        refuse_existing "/etc/systemd/system/$unit.d"
        refuse_existing "/run/systemd/system/$unit.d"
    fi
done

if [ "$1" = install ]; then
    refuse_existing /usr/bin/lurewall
fi
