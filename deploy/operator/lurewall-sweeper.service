# This timer is opt-in and independent of the main service.
[Unit]
Description=Lurewall timed firewall cleanup
OnFailure=lurewall-notify-failure.service

[Service]
Type=oneshot
User=lurewall
Group=lurewall
ExecStart=/opt/lurewall/current/bin/lurewall sweep \
    --event-log /var/lib/lurewall/sweeper/events.log \
    --key /var/lib/lurewall/keys/lurewall.key
TimeoutStartSec=45s
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
ReadWritePaths=/var/lib/lurewall/sweeper
UMask=0077
