# --- Secrets: never committed -------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
*.token
secrets/

# --- Per-installation state: generated locally, never in the repo --------
# Canary wording, decoy paths, the lookup table, signing keys, event logs and
# checkpoints are generated at each installation and live outside the repo.
state/
var/
*.jsonl
*.json.log
*.log
*.offset
*.ots

